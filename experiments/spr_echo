#!/usr/bin/env python3
"""
SPR Echo — encode + tree forward + decode
echo: all-1 params → tree output = input → decode → original text
"""
import sys, numpy as np

def tree_forward(tokens, params, depth, level=0):
    if depth == 0 or len(tokens) <= 1:
        return tokens
    p = params[level][:len(tokens)]
    x = tokens * p
    mid = len(x) // 2
    left = tree_forward(x[:mid], params, depth-1, level+1)
    right = tree_forward(x[mid:], params, depth-1, level+1)
    return np.concatenate([left, right])

text = sys.stdin.buffer.read().decode('utf-8')
if not text.strip():
    sys.exit(0)

# ── encode: text → token embeddings ──
tokens = np.array([ord(c) / 65536.0 for c in text], dtype=np.float32)
n = len(tokens)

# pad to 2^k
k = 1
while k < n:
    k *= 2
tokens_padded = np.pad(tokens, (0, k - n), constant_values=0.5)

# ── tree forward ──
depth = int(np.log2(len(tokens_padded)))
params = [np.ones(len(tokens_padded) // (2**i), dtype=np.float32) for i in range(depth)]
output = tree_forward(tokens_padded, params, depth)[:n]  # 去 pad

# ── decode: tree output → text ──
decoded = ''.join(chr(max(0, min(65535, int(o * 65536)))) for o in output)

loss = ((output - tokens) ** 2).mean()
sys.stdout.write(decoded)
sys.stderr.write(f"[SPR] n={n} depth={depth} loss={loss:.6f} output=input={np.allclose(tokens, output)}\n")
