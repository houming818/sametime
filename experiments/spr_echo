#!/usr/bin/env python3
"""
SPR Echo — 固定二分树 + 每层参数
Usage: echo "你好" | spr_echo
"""
import sys, numpy as np

def tree_forward(tokens, params, depth, level=0):
    if depth == 0 or len(tokens) <= 1:
        return tokens
    p = params[level][:len(tokens)]
    x = tokens * p
    mid = len(x) // 2
    left = tree_forward(x[:mid], params, depth-1, level+1)
    right = tree_forward(x[mid:], params, depth-1, level+1)
    return np.concatenate([left, right])

text = sys.stdin.buffer.read().decode('utf-8')
if not text.strip():
    sys.exit(0)

# 编码：每个字符的 Unicode codepoint 做 token
tokens = np.array([ord(c) / 65536.0 for c in text], dtype=np.float32)
n = len(tokens)
# 补到 2^k
k = 1
while k < n:
    k *= 2
tokens = np.pad(tokens, (0, k - n), constant_values=0.5)

depth = int(np.log2(len(tokens)))
params = [np.ones(len(tokens) // (2**i), dtype=np.float32) for i in range(depth)]

output = tree_forward(tokens, params, depth)
loss = ((output[:n] - tokens[:n]) ** 2).mean()

sys.stdout.write(text)
sys.stderr.write(f"[SPR] n={n} depth={depth} loss={loss:.6f} echo={'OK' if np.allclose(tokens, output) else 'FAIL'}\n")
