# SaTi 配置文件模板
# 在 CI/CD 中创建 .env 文件并注入 secrets

SMPT_SERVER=smtp.126.com
SMTP_PORT=465
SMTP_USERNAME=houming818@126.com
SMTP_PASSWORD=${GITEA_SMTP_PASSWORD}
SMTP_FROM=houming818@126.com
SMTP_TO=houming818@qq.com

# CI/CD SSH 密钥
DEPLOY_SSH_KEY=${GITEA_DEPLOY_SSH_KEY}
DEPLOY_USER=nio

# SaTi 评估配置
BENCH=mmlu_pro
MODEL=llama-3-8b
OUTPUT_DIR=./eval/results

# Docker 镜像注册中心认证
DOCKER_REGISTRY_HOST=reg.grepcode.cn
DOCKER_REGISTRY_USER=niograpcode
